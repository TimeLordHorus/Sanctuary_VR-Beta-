; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sanctuary VR"
config/description="Open source VR environment with cross-platform compatibility"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SanctuaryVRCore="*res://scripts/core/sanctuary_vr_core.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/msaa_3d=2
vrs/mode=1
vrs/texture="res://vrs_texture.tres"

[xr]

openxr/enabled=true
openxr/default_action_map="res://openxr_action_map.tres"
openxr/form_factor="head_mounted_display"
openxr/view_configuration="stereo"
openxr/reference_space="stage"
openxr/submit_depth_buffer=true
openxr/startup_alert=false
openxr/extensions/hand_tracking=true
openxr/extensions/eye_gaze_interaction=true

[physics]

3d/default_gravity=9.8
3d/default_linear_damp=0.1
3d/default_angular_damp=0.1

[input]

vr_trigger={
"deadzone": 0.1,
"events": []
}

vr_grip={
"deadzone": 0.1,
"events": []
}
